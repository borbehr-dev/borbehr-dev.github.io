{% macro icon(name, size = 20, className = '') %}
  {% if name === 'arrow-up-right' %}
    <svg class="icon {{ className }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M7 17 17 7M9 7h8v8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {% elif name === 'arrow-right' %}
    <svg class="icon {{ className }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M4 12h15m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {% elif name === 'arrow-left' %}
    <svg class="icon {{ className }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M20 12H5m6 6-6-6 6-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {% elif name === 'play' %}
    <svg class="icon icon--fill {{ className }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M8.5 5.8c0-.8.9-1.3 1.6-.9l8.4 5.3c.7.4.7 1.4 0 1.8l-8.4 5.3c-.7.4-1.6-.1-1.6-.9V5.8Z"/></svg>
  {% elif name === 'pause' %}
    <svg class="icon icon--fill {{ className }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><rect x="6.5" y="5" width="4" height="14" rx="1"/><rect x="13.5" y="5" width="4" height="14" rx="1"/></svg>
  {% elif name === 'prev' %}
    <svg class="icon icon--fill {{ className }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M6 5h2v14H6zM18.6 6.1c.7-.4 1.4.1 1.4.8v10.2c0 .7-.7 1.2-1.4.8l-8.2-5.1a.9.9 0 0 1 0-1.6l8.2-5.1Z"/></svg>
  {% elif name === 'next' %}
    <svg class="icon icon--fill {{ className }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M16 5h2v14h-2zM5.4 6.1C4.7 5.7 4 6.2 4 6.9v10.2c0 .7.7 1.2 1.4.8l8.2-5.1a.9.9 0 0 0 0-1.6L5.4 6.1Z"/></svg>
  {% elif name === 'shuffle' %}
    <svg class="icon {{ className }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M4 7h2.5c4.5 0 6.5 10 11 10H20m0 0-3-3m3 3-3 3M4 17h2.5c1.6 0 2.9-1.3 4.1-3m2.8-4c1.2-1.7 2.5-3 4.1-3H20m0 0-3-3m3 3-3 3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {% elif name === 'repeat' %}
    <svg class="icon {{ className }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="m17 2 4 4-4 4M21 6H8a4 4 0 0 0-4 4v1M7 22l-4-4 4-4M3 18h13a4 4 0 0 0 4-4v-1" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {% elif name === 'repeat-one' %}
    <svg class="icon {{ className }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="m17 2 4 4-4 4M21 6H8a4 4 0 0 0-4 4v1M7 22l-4-4 4-4M3 18h13a4 4 0 0 0 4-4v-1" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/><path d="M11.5 10.5 13 9.4v5.2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {% elif name === 'volume' %}
    <svg class="icon {{ className }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M4 9.5v5h3.2L12 18V6L7.2 9.5H4Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M16 9a4.2 4.2 0 0 1 0 6M18.7 6.3a8 8 0 0 1 0 11.4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
  {% elif name === 'volume-off' %}
    <svg class="icon {{ className }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M4 9.5v5h3.2L12 18V6L7.2 9.5H4Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="m16 9 5 5m0-5-5 5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
  {% elif name === 'download' %}
    <svg class="icon {{ className }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M12 3v12m0 0 4-4m-4 4-4-4M5 20h14" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {% elif name === 'close' %}
    <svg class="icon {{ className }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="m6 6 12 12M18 6 6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
  {% elif name === 'menu' %}
    <svg class="icon {{ className }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
  {% elif name === 'search' %}
    <svg class="icon {{ className }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.7"/><path d="m16 16 4.5 4.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
  {% elif name === 'telegram' %}
    <svg class="icon icon--fill {{ className }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M20.7 4.2 17.9 19c-.2 1-.8 1.2-1.6.8l-4.5-3.3-2.2 2.1c-.2.2-.4.4-.9.4l.3-4.5 8.2-7.4c.4-.3-.1-.5-.5-.2L7.5 13l-4.3-1.3c-.9-.3-.9-.9.2-1.3L19 3.9c.8-.3 1.5.2 1.2.3Z"/></svg>
  {% elif name === 'github' %}
    <svg class="icon icon--fill {{ className }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path fill-rule="evenodd" d="M12 2C6.48 2 2 6.58 2 12.23c0 4.52 2.87 8.35 6.84 9.7.5.1.68-.22.68-.49l-.01-1.9c-2.78.62-3.37-1.2-3.37-1.2-.45-1.18-1.11-1.5-1.11-1.5-.91-.64.07-.63.07-.63 1 .08 1.53 1.06 1.53 1.06.9 1.57 2.35 1.11 2.92.85.09-.66.35-1.11.63-1.37-2.22-.26-4.55-1.14-4.55-5.06 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.7 0 0 .84-.28 2.75 1.05A9.3 9.3 0 0 1 12 6.95c.85 0 1.7.12 2.5.35 1.9-1.33 2.74-1.05 2.74-1.05.55 1.4.2 2.44.1 2.7.64.72 1.03 1.63 1.03 2.75 0 3.93-2.34 4.8-4.57 5.05.36.32.68.94.68 1.9l-.01 2.79c0 .27.18.6.69.49A10.02 10.02 0 0 0 22 12.23C22 6.58 17.52 2 12 2Z" clip-rule="evenodd"/></svg>
  {% elif name === 'check' %}
    <svg class="icon {{ className }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="m5 12.5 4.5 4.5L19 7" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {% elif name === 'external' %}
    <svg class="icon {{ className }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M14 4h6v6M20 4l-8.5 8.5M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {% elif name === 'headphones' %}
    <svg class="icon {{ className }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M4 14v-2a8 8 0 0 1 16 0v2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><path d="M4 14h3v6H5.5A1.5 1.5 0 0 1 4 18.5V14Zm16 0h-3v6h1.5a1.5 1.5 0 0 0 1.5-1.5V14Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>
  {% elif name === 'code' %}
    <svg class="icon {{ className }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="m8 7-5 5 5 5m8-10 5 5-5 5M14 4l-4 16" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {% elif name === 'wave' %}
    <svg class="icon {{ className }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M3 12h2m2-4v8m3-10v12m3-9v6m3-8v10m3-7v4m2-2h1" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
  {% elif name === 'spark' %}
    <svg class="icon {{ className }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M12 2v20M2 12h20M5 5l14 14M19 5 5 19" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
  {% elif name === 'music' %}
    <svg class="icon {{ className }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M9 18V6l10-2v12M9 18a3 3 0 1 1-3-3h3Zm10-2a3 3 0 1 1-3-3h3Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {% elif name === 'disc' %}
    <svg class="icon {{ className }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.6"/><path d="M12 3v3m0 12v3M3 12h3m12 0h3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
  {% endif %}
{% endmacro %}
