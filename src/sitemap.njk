---
permalink: /sitemap.xml
layout: false
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for item in site.nav %}
  <url>
    <loc>{{ item.href | absoluteUrl(site.url) }}</loc>
    <lastmod>{{ site.buildDateShort }}</lastmod>
    <changefreq>{{ 'weekly' if item.key === 'home' else 'monthly' }}</changefreq>
    <priority>{{ '1.0' if item.key === 'home' else '0.8' }}</priority>
  </url>
{%- endfor %}
</urlset>
